@layout.app()
  @body({
  class:['bg-default']
  })
    @!nav()
    <div class="flex flex-col w-full">
      <div class="flex flex-row h-full w-full items-center justify-center">
        <div class="h-96 flex flex-row justify-center overflow-hidden rounded-r-lg">
          <div class="bg-signup w-96 bg-cover bg-center">
          </div>
          <div
            class="w-96 bg-black bg-opacity-80 p-10 rounded-r-lg  border-r border-t border-b border-night-market"
          >
            @form({action: route('user.create') , method:'post'})
              @!input({
              name: 'name',
              type: 'text',
              id: 'name',
              placeholder: 'Username123',
              })
              @!input({
              name: 'email',
              type: 'email',
              id: 'email',
              placeholder: 'name@flowbite.com',
              })
              @!input({
              name: 'password',
              type: 'password',
              id: 'password',
              placeholder: 'Password',
              })
              @button({type: 0, 'data-value': 'Submit'})
                Submit
              @end
            @end
          </div>
        </div>
      </div>
      @!footer()
    </div>
  @end
@end
